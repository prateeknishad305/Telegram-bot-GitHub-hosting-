# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token

# Public HTTPS base URL of this service (used for Mini App + preview links)
PUBLIC_URL=https://runner.example.com

# Comma separated Telegram numeric user IDs allowed to use the bot.
# Leave empty to allow everyone (NOT recommended for a public bot).
ALLOWED_USER_IDS=

# Comma separated Telegram numeric user IDs with admin rights (can stop any job).
ADMIN_USER_IDS=

# Optional: only allow repositories owned by these GitHub users/orgs.
# Empty means "any public GitHub repository".
ALLOWED_REPO_OWNERS=

# Optional GitHub token. Needed for private repos and higher API limits.
GITHUB_TOKEN=

# Execution limits per sandboxed job
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=3600
MEM_LIMIT=1g
NANO_CPUS=1000000000
PIDS_LIMIT=256

# Preview links
# If set, previews are served from https://<job-id>.<domain> (wildcard DNS + TLS).
# Otherwise previews are served under PUBLIC_URL/preview/<job-id>/.
PREVIEW_BASE_DOMAIN=
PORT_RANGE_START=20000
PORT_RANGE_END=30000

# Web server bind address (put a TLS reverse proxy in front)
WEB_HOST=0.0.0.0
WEB_PORT=8080
ENABLE_TERMINAL=true

# Secret used to sign short-lived Mini App session tokens.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# LOCAL DEVELOPMENT ONLY. When set, the Mini App can be opened in a normal
# browser with the query string ?dev=1 and will act as this Telegram user id.
# Never set this on a public deployment.
DEV_LOGIN_USER_ID=0

# Storage
DATA_DIR=./data
DOCKER_NETWORK=tgbot-runner

# Docker daemon connection. Leave empty to auto-detect: /var/run/docker.sock
# is tried first, then the rootless Docker/Podman socket of the current user.
# Rootless Docker: DOCKER_HOST=unix:///run/user/1000/docker.sock
# Rootless Podman: DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
DOCKER_HOST=

# docker-compose only: daemon socket mounted into the bot container, and the
# host UID/GID it runs as. For rootless Docker/Podman set
# DOCKER_SOCKET=/run/user/1000/docker.sock (and optionally RUN_AS_UID/RUN_AS_GID
# to your host user; rootless engines already map container root to your user).
DOCKER_SOCKET=/var/run/docker.sock
RUN_AS_UID=0
RUN_AS_GID=0

# Release archives (zip / tar.gz). The bot downloads, extracts, runs and hosts them.
ARCHIVE_MAX_BYTES=536870912
ARCHIVE_EXTRACT_MAX_BYTES=2147483648

# Cache cleanup every 3 hours. Directories older than CACHE_MAX_AGE_SECONDS are removed.
CACHE_CLEANUP_INTERVAL_SECONDS=10800
CACHE_MAX_AGE_SECONDS=10800

# If disk usage stays at or above this percent after cleanup, exit so a supervisor
# (systemd, docker restart, Railway) can restart the process. Off by default.
RESTART_ON_DISK_FULL=false
DISK_RESTART_PERCENT=95

